# 기상청 API허브 (단기예보 조회서비스 — VilageFcstInfoService_2.0)
# https://apihub.kma.go.kr
KMA_API_KEY=

# 기상청 API허브 기상특보 (apihub.kma.go.kr 자체 인증키 — 위 KMA_API_KEY(data.go.kr 공용키)와 다른 키 체계.
# wrn_now_data.php API에 대한 활용신청/승인이 별도로 필요)
KMA_HUB_API_KEY=

# 산림청 국립산림과학원 산불위험예보정보 (공공데이터포털)
FOREST_FIRE_API_KEY=

# 아래 둘은 backend/src/config/env.ts에서만 쓰이는 "로컬 Express 개발 서버" 전용 설정.
# Vercel 대시보드에는 등록할 필요 없음 (Vercel Services 배포에서는 포트/CORS를 Vercel이 관리).
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# ── 기상청 초단기실황 호출량 조절 (모두 선택. 비우면 아래 기본값) ──
# 격자 날씨를 다시 조회하는 주기(시간). 하루 호출량 = 741격자 × (24 ÷ 값): 3 → 5,928건, 4 → 4,446건, 2 → 8,892건(목표 8,000 초과).
# 개발 중 호출이 걱정되면 값을 키운다(예: 6).
KMA_CACHE_HOURS=3
# 이 프로세스가 하루에 쓸 기상청 호출 수의 상한(일일 한도 10,000건 보호용 안전장치)
KMA_DAILY_CALL_LIMIT=8000
# /api/live 한 번의 응답에서 기상청 조회에 쓸 최대 시간(ms). 넘으면 못 채운 격자는 직전 값으로 응답하고 다음 요청이 이어서 채운다. 0 이면 제한 없음.
KMA_LIVE_DEADLINE_MS=7000
# 개발 서버 재시작(tsx watch)에도 격자 캐시·호출 수를 .cache/ 에 보존. 끄려면 0. (Vercel에서는 항상 꺼짐)
KMA_DISK_CACHE=1
