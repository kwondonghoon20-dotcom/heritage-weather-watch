# 공공데이터포털 - 문화재(국가유산) 공간정보 Open API
# https://www.data.go.kr/data/3070426/openapi.do
HERITAGE_API_KEY=

# 기상청 API허브
# https://apihub.kma.go.kr
KMA_API_KEY=

# 산림청 산불위험예보 (공공데이터포털에서 검색)
FOREST_FIRE_API_KEY=

# (선택) 카카오맵 JS SDK를 쓸 경우에만 필요. Leaflet+OSM 사용 시 불필요.
KAKAO_MAP_APP_KEY=

# (선택) backend 서버 설정 — 기본값 그대로 써도 무방
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
