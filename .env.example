# 기상청 API허브 (단기예보 조회서비스 — VilageFcstInfoService_2.0)
# https://apihub.kma.go.kr
KMA_API_KEY=

# 산림청 국립산림과학원 산불위험예보정보 (공공데이터포털)
FOREST_FIRE_API_KEY=

# 아래 둘은 backend/src/config/env.ts에서만 쓰이는 "로컬 Express 개발 서버" 전용 설정.
# Vercel 대시보드에는 등록할 필요 없음 (Vercel Services 배포에서는 포트/CORS를 Vercel이 관리).
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
